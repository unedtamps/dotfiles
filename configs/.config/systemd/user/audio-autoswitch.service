[Unit]
Description=Auto-switch default audio sink to Bluetooth when a headset connects
After=pipewire.service pipewire-pulse.service wireplumber.service

[Service]
Type=simple
ExecStart=/usr/bin/bash /home/nedo/.config/pipewire/autoswitch-bluetooth.sh
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
